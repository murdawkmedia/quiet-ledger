# Deny by default: private runtime data never enters the Docker build context.
**
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!client/
!client/**
!server/
!server/**
!shared/
!shared/**
!integrations/
!integrations/**
!functions/
!functions/**
!scripts/
!scripts/build-hosted.mjs
!ops/
!ops/backup.ts
!ops/pages-entry.ts
!ops/Dockerfile.hosted
!ops/compose.hosted.yml
!ops/Dockerfile.selfhost
!ops/Dockerfile.selfhost.dockerignore
# Defense in depth if a private artifact was accidentally placed under code.
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.qlb
**/*.key
**/*.pem
**/.runtime/**
**/secrets/**
**/backups/**
**/.git/**
