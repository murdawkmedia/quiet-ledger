# Local MVP: live receiving is explicit per connection; payouts remain simulated.
SIMULATION_ONLY=true
PORT=4317
DATA_DIR=.runtime
# Optional owner scenario file outside this repository. Demo login cannot read it.
PRIVATE_SCENARIO_PATH=
# Optional owner token; when absent startup creates DATA_DIR/owner-token privately.
OWNER_TOKEN=
# Default hostnames: localhost,127.0.0.1,[::1]. Blank keeps those defaults.
# ALLOWED_HOSTS=
# Square sandbox receiving is owner-only and separate from the simulation ledger.
# Store only a Sandbox token in a private 0600 file outside source.
# SQUARE_SANDBOX_TOKEN_FILE=
# SQUARE_SANDBOX_LOCATION_ID=
# Wise remains an unconnected library client.
# WISE_SANDBOX_TOKEN=
# WISE_BUSINESS_PROFILE_ID=

# Optional external private 0600 JSON for live/test receiving and read-only collateral.
# RECEIVING_CONNECTIONS_FILE=
# API token is generated privately at DATA_DIR/api-token, never printed.
# MCP reads it using QUIET_LEDGER_API_TOKEN_FILE; see docs/MCP.md.
